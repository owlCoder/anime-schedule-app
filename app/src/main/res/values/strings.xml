    <string name="cl_35_1">Marking the last episode with "+1" now prompts you to rate the show and mark it Completed (skipped for shows with an unknown episode count)</string>
    <string name="cl_35_date">July 2026</string>

    <string name="cl_32_1">Fixed video fullscreen button not working on some watch-source sites</string>
    <string name="cl_32_date">July 2026</string>

    <string name="cl_31_1">Watch sources — add streaming sites (or apps like Netflix/Crunchyroll) per anime, opened in a fullscreen in-app browser</string>
    <string name="cl_31_2">"Open in app" option per watch source, hands off to an installed app instead of the in-app browser</string>
    <string name="cl_31_3">Built-in ad blocker for the in-app browser</string>
    <string name="cl_31_4">Character list on anime details — tap a character to see their bio</string>
    <string name="cl_31_5">Collapsible synopsis with "Read more"</string>
    <string name="cl_31_6">Livelier onboarding — animated logo and page transitions</string>
    <string name="cl_31_7">Notification permission is now only requested when you enable notifications, not on first launch</string>
    <string name="cl_31_8">Layout and spacing polish across the detail and settings screens</string>
    <string name="cl_31_date">July 2026</string>

