    <string name="changelog_hero_description">An AMOLED look, more reliable account state, and a smarter schedule.</string>
    <string name="changelog_nav_title">Unified iOS navigation</string>
    <string name="changelog_nav_description">The navbar, toolbar, and controls now share one neutral visual system.</string>
    <string name="changelog_motion_title">Smoother transitions and sheets</string>
    <string name="changelog_motion_description">Navigation, date selection, cards, and sheets now move more calmly and naturally.</string>
    <string name="changelog_filters_title">AMOLED theme and better accent colors</string>
    <string name="changelog_filters_description">A true-black canvas, clear card hierarchy, and optimized colors for light and dark modes.</string>
    <string name="changelog_states_title">Better onboarding and MyAnimeList account state</string>
    <string name="changelog_states_description">Language comes first, while sign-in and linked-account state now refresh reliably.</string>
    <string name="changelog_about_title">More complete translations and a smarter schedule</string>
    <string name="changelog_about_description">Dates follow the app language and selected day, while Recently changed appears reliably again.</string>
    <string name="changelog_footer">Made with care by the AnimeSchedule team</string>

