<?xml version="1.0" encoding="utf-8"?>
<!--
    The OAuth tokens live in EncryptedSharedPreferences, whose AES key sits in the Android
    Keystore and never leaves the device. Backing the file up would restore ciphertext that can
    no longer be decrypted on another device, and tokens should not be copied off the device at all.
    Everything else (database, preferences) is restored normally.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_tokens.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_tokens.xml" />
    </device-transfer>
</data-extraction-rules>
