<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      "Niti" launcher mark (matches the Tapiz ecosystem's 3-stroke halo technique,
      scaled to Android's 108x108 adaptive-icon canvas / 48-unit design grid:
      u = 108/48 = 2.25). Ink bar = horizontal "schedule" strip; accent thread =
      rounded TV/monitor silhouette ("anime" viewing), color #E0457B (pink,
      deliberately outside the Tapiz ecosystem palette since this is not a
      Tapiz product, just stylistically aligned).
    -->

    <!-- Ink bar: M10 24 H38 -> scaled -->
    <path
        android:pathData="M22.5,54 H85.5"
        android:strokeColor="#221C30"
        android:strokeWidth="20.25"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Halo: same path as accent, wider, tile-background color to punch the gap -->
    <path
        android:pathData="M31.5,31.5 H76.5 V72 H31.5 Z"
        android:strokeColor="#F6F4FA"
        android:strokeWidth="33.75"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Accent thread: rounded TV/monitor silhouette -->
    <path
        android:pathData="M31.5,31.5 H76.5 V72 H31.5 Z"
        android:strokeColor="#E0457B"
        android:strokeWidth="20.25"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
